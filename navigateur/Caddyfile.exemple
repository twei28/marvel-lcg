# BLOC INSTALLE sur le serveur le 07/10/2026 (dans /etc/caddy/Caddyfile, qui n'est PAS ecrase par deployer.ps1 : il importe
# d'autres sites). A inserer DANS le bloc `*.{$DOMAINE} { ... }` (celui qui porte `tls { dns cloudflare ... }` et les routes
# p1..p30), AVANT `@p1 host p1.{$DOMAINE}`. Le certificat wildcard et le DNS generique couvrent deja play.<domaine>.
# Les deux en-tetes COOP/COEP sont OBLIGATOIRES : sans eux le moteur ne peut pas tourner dans la page. Ils ne concernent QUE play.
# Valider avant de recharger :  set -a; . /etc/caddy/cloudflare.env; set +a; caddy validate --config /etc/caddy/Caddyfile
#
#	@play host play.{$DOMAINE}
#	handle @play {
#		encode zstd gzip
#		header Cross-Origin-Opener-Policy same-origin
#		header Cross-Origin-Embedder-Policy credentialless
#		header X-Content-Type-Options nosniff
#
#		# Version du paquet et page de demarrage : jamais en cache. Le reste porte un ?v=<version> ou ne change pas.
#		@frais path /version.json /navigateur.html
#		header @frais Cache-Control "no-store"
#		@stable path /pyodide* /moteur.zip /*.whl /css/* /js/* /fonts/* /img/* /app/*
#		header @stable Cache-Control "public, max-age=86400"
#
#		redir / /navigateur.html 302
#
#		# Images demandees PAR LEUR NOM, a la racine (« /fr_01001a », logos « /narwhal-thor ») ou en haute definition
#		# (« /hd/01001a ») : le moteur classique les sert par sa route attrape-tout, le serveur statique non (404,
#		# constate en ligne le 07/10/2026 : aucune image dans l'ecran de preparation). Elles passent par /scan/.
#		# Un nom sans point ni barre : jamais une page ni un fichier du paquet (qui ont tous une extension ou un dossier).
#		@image_nue path_regexp image_nue ^/[A-Za-z0-9_-]+$
#		rewrite @image_nue /scan{path}
#		@image_hd path_regexp image_hd ^/hd/([A-Za-z0-9_-]+)$
#		rewrite @image_hd /scan/{re.image_hd.1}
#
#		# Scans : d'abord les versions REDRESSEES (navigateur/preparer-scans.py), puis les originaux.
#		# Le moteur redresse en portrait toute image plus large que haute ; le plateau les remet a plat par CSS.
#		handle /scan/* {
#			uri strip_prefix /scan
#			root * /opt/narwhal-play-scans
#			try_files /pivotes/pics-fr{path}.webp /pivotes/pics-fr{path}.jpg /pivotes/pics{path}.webp /pivotes/pics{path}.jpg \
#			          /originaux/pics-fr{path}.webp /originaux/pics-fr{path}.jpg /originaux/pics{path}.webp /originaux/pics{path}.jpg \
#			          /originaux/textures{path}.webp /originaux/textures{path}.png /originaux/textures{path}.jpg /originaux/textures{path}.svg /originaux/cache{path}.jpg
#			file_server
#		}
#
#		# Miniatures des cartes de la table : la miniature si elle existe, sinon le scan complet (comme Cache.LoadVignette).
#		handle /vignette/* {
#			uri strip_prefix /vignette
#			root * /opt/narwhal-play-scans
#			try_files /pivotes/vignettes{path}.jpg /originaux/vignettes{path}.jpg \
#			          /pivotes/pics-fr{path}.webp /pivotes/pics-fr{path}.jpg /pivotes/pics{path}.webp /pivotes/pics{path}.jpg \
#			          /originaux/pics-fr{path}.webp /originaux/pics-fr{path}.jpg /originaux/pics{path}.webp /originaux/pics{path}.jpg \
#			          /originaux/textures{path}.webp /originaux/textures{path}.png /originaux/textures{path}.jpg /originaux/textures{path}.svg /originaux/cache{path}.jpg
#			file_server
#		}
#
#		root * /opt/narwhal-play
#		file_server
#	}
#
# Dossiers sur le serveur : /opt/narwhal-play (navigateur/dist) ; /opt/narwhal-play-scans/originaux = COPIE de pics-fr, pics, textures, cache, vignettes
# (Caddy ne peut pas lire /opt/narwhal, en 750 narwhal) ; /opt/narwhal-play-scans/pivotes (sortie de preparer-scans.py,
# genere SUR le serveur) et /opt/narwhal-play-scans/originaux (lien vers Fusion/marvel-lcg-src/assets).
