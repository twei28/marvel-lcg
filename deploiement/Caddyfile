# Caddyfile — NarwhalChampions
# Le domaine est injecté au lancement : DOMAINE=narwhalchampions.com dans
# /etc/caddy/cloudflare.env. Ne pas écrire le domaine en dur ici.
#
# Deux blocs seulement :
#   - l'apex, servi par l'orchestrateur (127.0.0.1:8080), certificat HTTP-01 ;
#   - le wildcard *.domaine, certificat obtenu par challenge DNS Cloudflare,
#     qui contient les 30 routes statiques p1..p30 vers les ports 2351..2380.
#
# Les 20 routes ne bougent jamais : c'est l'orchestrateur qui alloue les tables.
# Aucune reconfiguration de Caddy en vol.
#
# Le WebSocket (/ws) n'exige aucune directive : reverse_proxy relaie
# nativement l'Upgrade HTTP/1.1 et ne coupe pas les connexions longues.

{
	email {$EMAIL_ACME}
}

# --- Accueil, comptes, création de parties ------------------------------------
{$DOMAINE}, www.{$DOMAINE} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080

	# HSTS. Un navigateur qui a vu cet en-tête une fois ne retente plus jamais le
	# http:// sur ce domaine : il part directement en https, sans la redirection
	# pendant laquelle un intermédiaire pouvait lire le cookie de session au vol.
	# `includeSubDomains` couvre du même coup les trente tables p1..p30, dont les
	# URL portent les clés de siège. Un an, la valeur d'usage.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Active Discord (ajoute le 28/09/2026, feature "activite Discord") : sans
	# ceci, un navigateur bloque l'affichage du site dans l'iframe que Discord
	# pose autour de l'activite. Domaines d'apres la doc du SDK Discord au
	# moment d'ecrire, NON VERIFIES en conditions reelles (aucun client
	# Discord disponible pour le confirmer) -- voir docs/reference/DISCORD.md.
	header Content-Security-Policy "frame-ancestors https://discord.com https://*.discordsays.com"

	log {
		output file /var/log/caddy/accueil.log {
			roll_size 20MiB
			roll_keep 5
		}
		# Les clés de siège et d'invitation voyagent dans la query string : sans
		# ce filtre, elles finissaient en clair dans les journaux (audit B, S5).
		# Le filtre « query » demande Caddy 2.5 ou plus récent.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace key REDACTED
				}
			}
		}
	}
}

# --- Les 20 tables ------------------------------------------------------------
*.{$DOMAINE} {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	@p1 host p1.{$DOMAINE}
	handle @p1 {
		reverse_proxy 127.0.0.1:2351
	}

	@p2 host p2.{$DOMAINE}
	handle @p2 {
		reverse_proxy 127.0.0.1:2352
	}

	@p3 host p3.{$DOMAINE}
	handle @p3 {
		reverse_proxy 127.0.0.1:2353
	}

	@p4 host p4.{$DOMAINE}
	handle @p4 {
		reverse_proxy 127.0.0.1:2354
	}

	@p5 host p5.{$DOMAINE}
	handle @p5 {
		reverse_proxy 127.0.0.1:2355
	}

	@p6 host p6.{$DOMAINE}
	handle @p6 {
		reverse_proxy 127.0.0.1:2356
	}

	@p7 host p7.{$DOMAINE}
	handle @p7 {
		reverse_proxy 127.0.0.1:2357
	}

	@p8 host p8.{$DOMAINE}
	handle @p8 {
		reverse_proxy 127.0.0.1:2358
	}

	@p9 host p9.{$DOMAINE}
	handle @p9 {
		reverse_proxy 127.0.0.1:2359
	}

	@p10 host p10.{$DOMAINE}
	handle @p10 {
		reverse_proxy 127.0.0.1:2360
	}

	@p11 host p11.{$DOMAINE}
	handle @p11 {
		reverse_proxy 127.0.0.1:2361
	}

	@p12 host p12.{$DOMAINE}
	handle @p12 {
		reverse_proxy 127.0.0.1:2362
	}

	@p13 host p13.{$DOMAINE}
	handle @p13 {
		reverse_proxy 127.0.0.1:2363
	}

	@p14 host p14.{$DOMAINE}
	handle @p14 {
		reverse_proxy 127.0.0.1:2364
	}

	@p15 host p15.{$DOMAINE}
	handle @p15 {
		reverse_proxy 127.0.0.1:2365
	}

	@p16 host p16.{$DOMAINE}
	handle @p16 {
		reverse_proxy 127.0.0.1:2366
	}

	@p17 host p17.{$DOMAINE}
	handle @p17 {
		reverse_proxy 127.0.0.1:2367
	}

	@p18 host p18.{$DOMAINE}
	handle @p18 {
		reverse_proxy 127.0.0.1:2368
	}

	@p19 host p19.{$DOMAINE}
	handle @p19 {
		reverse_proxy 127.0.0.1:2369
	}

	@p20 host p20.{$DOMAINE}
	handle @p20 {
		reverse_proxy 127.0.0.1:2370
	}

	@p21 host p21.{$DOMAINE}
	handle @p21 {
		reverse_proxy 127.0.0.1:2371
	}

	@p22 host p22.{$DOMAINE}
	handle @p22 {
		reverse_proxy 127.0.0.1:2372
	}

	@p23 host p23.{$DOMAINE}
	handle @p23 {
		reverse_proxy 127.0.0.1:2373
	}

	@p24 host p24.{$DOMAINE}
	handle @p24 {
		reverse_proxy 127.0.0.1:2374
	}

	@p25 host p25.{$DOMAINE}
	handle @p25 {
		reverse_proxy 127.0.0.1:2375
	}

	@p26 host p26.{$DOMAINE}
	handle @p26 {
		reverse_proxy 127.0.0.1:2376
	}

	@p27 host p27.{$DOMAINE}
	handle @p27 {
		reverse_proxy 127.0.0.1:2377
	}

	@p28 host p28.{$DOMAINE}
	handle @p28 {
		reverse_proxy 127.0.0.1:2378
	}

	@p29 host p29.{$DOMAINE}
	handle @p29 {
		reverse_proxy 127.0.0.1:2379
	}

	@p30 host p30.{$DOMAINE}
	handle @p30 {
		reverse_proxy 127.0.0.1:2380
	}

	# --- L'activite Discord (29/09/2026) -----------------------------------------
	# Le « Root Mapping » du portail Discord vise CET hote. Discord ne charge
	# qu'une origine dans son cadre : toutes les tables y passent, aiguillees par
	# le cookie `nc_table` que pose l'orchestrateur en y asseyant quelqu'un. Sans
	# ce cookie, ou pour le parcours d'entree (lancement `frame_id`, connexion,
	# attente), tout va a l'orchestrateur. Voir docs/reference/DISCORD.md.
	@discord host discord.{$DOMAINE}
	handle @discord {
		@d_lancement query frame_id=*
		@d_site path /activite_discord /connexion /pret /entrer /narwhal.png /discord-sdk.js
		@d_t1 header_regexp Cookie (^|;\s*)nc_table=1(;|$)
		@d_t2 header_regexp Cookie (^|;\s*)nc_table=2(;|$)
		@d_t3 header_regexp Cookie (^|;\s*)nc_table=3(;|$)
		@d_t4 header_regexp Cookie (^|;\s*)nc_table=4(;|$)
		@d_t5 header_regexp Cookie (^|;\s*)nc_table=5(;|$)
		@d_t6 header_regexp Cookie (^|;\s*)nc_table=6(;|$)
		@d_t7 header_regexp Cookie (^|;\s*)nc_table=7(;|$)
		@d_t8 header_regexp Cookie (^|;\s*)nc_table=8(;|$)
		@d_t9 header_regexp Cookie (^|;\s*)nc_table=9(;|$)
		@d_t10 header_regexp Cookie (^|;\s*)nc_table=10(;|$)
		@d_t11 header_regexp Cookie (^|;\s*)nc_table=11(;|$)
		@d_t12 header_regexp Cookie (^|;\s*)nc_table=12(;|$)
		@d_t13 header_regexp Cookie (^|;\s*)nc_table=13(;|$)
		@d_t14 header_regexp Cookie (^|;\s*)nc_table=14(;|$)
		@d_t15 header_regexp Cookie (^|;\s*)nc_table=15(;|$)
		@d_t16 header_regexp Cookie (^|;\s*)nc_table=16(;|$)
		@d_t17 header_regexp Cookie (^|;\s*)nc_table=17(;|$)
		@d_t18 header_regexp Cookie (^|;\s*)nc_table=18(;|$)
		@d_t19 header_regexp Cookie (^|;\s*)nc_table=19(;|$)
		@d_t20 header_regexp Cookie (^|;\s*)nc_table=20(;|$)
		@d_t21 header_regexp Cookie (^|;\s*)nc_table=21(;|$)
		@d_t22 header_regexp Cookie (^|;\s*)nc_table=22(;|$)
		@d_t23 header_regexp Cookie (^|;\s*)nc_table=23(;|$)
		@d_t24 header_regexp Cookie (^|;\s*)nc_table=24(;|$)
		@d_t25 header_regexp Cookie (^|;\s*)nc_table=25(;|$)
		@d_t26 header_regexp Cookie (^|;\s*)nc_table=26(;|$)
		@d_t27 header_regexp Cookie (^|;\s*)nc_table=27(;|$)
		@d_t28 header_regexp Cookie (^|;\s*)nc_table=28(;|$)
		@d_t29 header_regexp Cookie (^|;\s*)nc_table=29(;|$)
		@d_t30 header_regexp Cookie (^|;\s*)nc_table=30(;|$)
		route {
			reverse_proxy @d_lancement 127.0.0.1:8080
			reverse_proxy @d_site 127.0.0.1:8080
			reverse_proxy @d_t1 127.0.0.1:2351
			reverse_proxy @d_t2 127.0.0.1:2352
			reverse_proxy @d_t3 127.0.0.1:2353
			reverse_proxy @d_t4 127.0.0.1:2354
			reverse_proxy @d_t5 127.0.0.1:2355
			reverse_proxy @d_t6 127.0.0.1:2356
			reverse_proxy @d_t7 127.0.0.1:2357
			reverse_proxy @d_t8 127.0.0.1:2358
			reverse_proxy @d_t9 127.0.0.1:2359
			reverse_proxy @d_t10 127.0.0.1:2360
			reverse_proxy @d_t11 127.0.0.1:2361
			reverse_proxy @d_t12 127.0.0.1:2362
			reverse_proxy @d_t13 127.0.0.1:2363
			reverse_proxy @d_t14 127.0.0.1:2364
			reverse_proxy @d_t15 127.0.0.1:2365
			reverse_proxy @d_t16 127.0.0.1:2366
			reverse_proxy @d_t17 127.0.0.1:2367
			reverse_proxy @d_t18 127.0.0.1:2368
			reverse_proxy @d_t19 127.0.0.1:2369
			reverse_proxy @d_t20 127.0.0.1:2370
			reverse_proxy @d_t21 127.0.0.1:2371
			reverse_proxy @d_t22 127.0.0.1:2372
			reverse_proxy @d_t23 127.0.0.1:2373
			reverse_proxy @d_t24 127.0.0.1:2374
			reverse_proxy @d_t25 127.0.0.1:2375
			reverse_proxy @d_t26 127.0.0.1:2376
			reverse_proxy @d_t27 127.0.0.1:2377
			reverse_proxy @d_t28 127.0.0.1:2378
			reverse_proxy @d_t29 127.0.0.1:2379
			reverse_proxy @d_t30 127.0.0.1:2380
			reverse_proxy 127.0.0.1:8080
		}
	}

	# Tout autre sous-domaine retombe sur l'accueil.
	handle {
		redir https://{$DOMAINE}{uri} permanent
	}

	# Une page de table ne doit pas transmettre son URL (clé de siège incluse)
	# aux sites qu'elle lierait : le Referer s'arrête au même domaine.
	header Referrer-Policy "same-origin"
	# Le HSTS de l'apex ne couvre les tables que pour un navigateur qui a déjà
	# vu l'apex en HTTPS. Un lien d'invitation arrive souvent AVANT : on le pose
	# donc aussi ici, sur les vingt tables.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Meme raison que sur l'apex : une table peut etre atteinte depuis
	# l'activite Discord (deuxieme URL Mapping cote Discord, une fois l'hote
	# redirige vers p<N>.{$DOMAINE}).
	header Content-Security-Policy "frame-ancestors https://discord.com https://*.discordsays.com"

	log {
		output file /var/log/caddy/tables.log {
			roll_size 20MiB
			roll_keep 5
		}
		# Même filtre que l'accueil : les clés de siège ne s'écrivent plus dans
		# les journaux (audit B, S5). Demande Caddy 2.5 ou plus récent.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace key REDACTED
				}
			}
		}
	}
}

# --- Hogwarts Battle (portage separe, ajoute le 22/09/2026) -------------------
import /etc/caddy/sites/hogwarts.caddy
